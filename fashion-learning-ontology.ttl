# Fashion information-architecture learning ontology, v0.1, generated 2026-11-14
# Placeholder namespaces (example.org): replace with your own before publishing.

@prefix jl: <https://example.org/learning-ontology#> .
@prefix id: <https://example.org/learning-data/> .
@prefix fd: <https://example.org/fashion-seed#> .
@prefix ex: <https://example.org/example-data/> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

jl:
    a owl:Ontology ;
    rdfs:label "Fashion information-architecture learning ontology"@en ;
    rdfs:comment "A learning ontology for becoming an ontology subject-matter expert for a fashion house. Layer 1 models the learning domain; layer 2 (fd:) is a seed model for fashion traceability. Placeholder namespaces: replace example.org with your own."@en ;
    dcterms:created "2026-11-14"^^xsd:date ;
    owl:versionInfo "0.1" ;
    dcterms:creator "Jazmin (learning project)" .

schema:Organization
    a owl:Class .

schema:Legislation
    a owl:Class .

schema:Report
    a owl:Class .

schema:CreativeWork
    a owl:Class .

schema:Event
    a owl:Class .

schema:Place
    a owl:Class .

schema:Product
    a owl:Class .

skos:Concept
    a owl:Class .

skos:ConceptScheme
    a owl:Class .

skos:related
    a owl:ObjectProperty .

skos:inScheme
    a owl:ObjectProperty .

schema:url
    a owl:AnnotationProperty .

dcterms:source
    a owl:AnnotationProperty .

dcterms:created
    a owl:AnnotationProperty .

dcterms:creator
    a owl:AnnotationProperty .

owl:versionInfo
    a owl:AnnotationProperty .

jl:LearningTarget
    a owl:Class ;
    rdfs:label "Learning target"@en ;
    rdfs:comment "Anything Jazmin plans to learn: a concept, organization, instrument, tool or distinction."@en .

jl:Concept
    a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:comment "An idea to understand, such as provenance or master data."@en ;
    rdfs:subClassOf jl:LearningTarget , skos:Concept ;
    owl:disjointWith jl:Organization .

jl:Distinction
    a owl:Class ;
    rdfs:label "Distinction"@en ;
    rdfs:comment "A pair or set of easily confused things that must be explainable without notes."@en ;
    rdfs:subClassOf jl:LearningTarget .

jl:Organization
    a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:comment "Any organization. What it is (type) is separate from what it does for the learner (role)."@en ;
    rdfs:subClassOf jl:LearningTarget , schema:Organization .

jl:StandardsBody
    a owl:Class ;
    rdfs:label "Standards body"@en ;
    rdfs:comment "Writes standards."@en ;
    rdfs:subClassOf jl:Organization .

jl:PrivateStandardsBody
    a owl:Class ;
    rdfs:label "Private standards body"@en ;
    rdfs:comment "Industry-owned standard, certification or assessment scheme owner. Not a law-maker."@en ;
    rdfs:subClassOf jl:StandardsBody .

jl:StandardsCommittee
    a owl:Class ;
    rdfs:label "Standards committee"@en ;
    rdfs:comment "A technical committee inside a standards body."@en ;
    rdfs:subClassOf jl:StandardsBody .

jl:GovernmentBody
    a owl:Class ;
    rdfs:label "Government body"@en ;
    rdfs:comment "Legislature, agency or intergovernmental body."@en ;
    rdfs:subClassOf jl:Organization .

jl:TradeAssociation
    a owl:Class ;
    rdfs:label "Trade association"@en ;
    rdfs:comment "Industry or trade body."@en ;
    rdfs:subClassOf jl:Organization .

jl:IndustryInitiative
    a owl:Class ;
    rdfs:label "Industry initiative"@en ;
    rdfs:comment "Coalition, consortium, project or campaign."@en ;
    rdfs:subClassOf jl:Organization .

jl:ProfessionalAssociation
    a owl:Class ;
    rdfs:label "Professional association"@en ;
    rdfs:comment "Association of practitioners."@en ;
    rdfs:subClassOf jl:Organization .

jl:Platform
    a owl:Class ;
    rdfs:label "Platform"@en ;
    rdfs:comment "Software or data platform."@en ;
    rdfs:subClassOf jl:Organization .

jl:Company
    a owl:Class ;
    rdfs:label "Company"@en ;
    rdfs:comment "A for-profit company: brand, laboratory, vendor, employer."@en ;
    rdfs:subClassOf jl:Organization .

jl:University
    a owl:Class ;
    rdfs:label "University"@en ;
    rdfs:comment "Educational institution."@en ;
    rdfs:subClassOf jl:Organization .

jl:Instrument
    a owl:Class ;
    rdfs:label "Instrument"@en ;
    rdfs:comment "A thing with a normative status: law, standard, scheme, framework or study."@en ;
    rdfs:subClassOf jl:LearningTarget .

jl:Law
    a owl:Class ;
    rdfs:label "Law"@en ;
    rdfs:comment "Binding legislation or regulation."@en ;
    rdfs:subClassOf jl:Instrument , schema:Legislation ;
    owl:disjointWith jl:Standard , jl:Framework .

jl:Standard
    a owl:Class ;
    rdfs:label "Standard"@en ;
    rdfs:comment "Voluntary technical standard or specification. Becomes required only when a law, contract or claim points to it."@en ;
    rdfs:subClassOf jl:Instrument .

jl:CertificationScheme
    a owl:Class ;
    rdfs:label "Certification scheme"@en ;
    rdfs:comment "A standard with a conformity-assessment process and certificates."@en ;
    rdfs:subClassOf jl:Standard .

jl:Framework
    a owl:Class ;
    rdfs:label "Framework"@en ;
    rdfs:comment "Guidance, reporting or assessment framework."@en ;
    rdfs:subClassOf jl:Instrument .

jl:ResearchStudy
    a owl:Class ;
    rdfs:label "Research study"@en ;
    rdfs:comment "Research that informs rules without binding anyone."@en ;
    rdfs:subClassOf jl:Instrument , schema:Report .

jl:Tool
    a owl:Class ;
    rdfs:label "Tool"@en ;
    rdfs:comment "Software or technology to be able to use."@en ;
    rdfs:subClassOf jl:LearningTarget .

jl:Skill
    a owl:Class ;
    rdfs:label "Skill"@en ;
    rdfs:comment "A competency a job asks for."@en .

jl:JobRequirement
    a owl:Class ;
    rdfs:label "Job requirement"@en ;
    rdfs:comment "A line from the source job description, with its fashion translation."@en .

jl:Deliverable
    a owl:Class ;
    rdfs:label "Deliverable"@en ;
    rdfs:comment "A portfolio output that demonstrates skills."@en ;
    rdfs:subClassOf schema:CreativeWork .

jl:Resource
    a owl:Class ;
    rdfs:label "Resource"@en ;
    rdfs:comment "A reading, page, training or event."@en ;
    rdfs:subClassOf schema:CreativeWork .

jl:Milestone
    a owl:Class ;
    rdfs:label "Regulatory milestone"@en ;
    rdfs:comment "A dated step in a law or standard lifecycle. May be a projection."@en ;
    rdfs:subClassOf schema:Event .

jl:Problem
    a owl:Class ;
    rdfs:label "Problem"@en ;
    rdfs:comment "A question the field must answer, mapped to where to start."@en .

jl:KnowledgeDomain
    a owl:Class ;
    rdfs:label "Knowledge domain"@en ;
    rdfs:comment "Top-level grouping, following the Reference Guide sections."@en ;
    rdfs:subClassOf skos:Concept .

jl:OrganizationRole
    a owl:Class ;
    rdfs:label "Organization role"@en ;
    rdfs:comment "What an organization does for the learner."@en ;
    rdfs:subClassOf skos:Concept .

jl:ProficiencyLevel
    a owl:Class ;
    rdfs:label "Proficiency level"@en ;
    rdfs:comment "How deeply to know something."@en ;
    rdfs:subClassOf skos:Concept .

jl:PriorityTier
    a owl:Class ;
    rdfs:label "Priority tier"@en ;
    rdfs:comment "When to study something."@en ;
    rdfs:subClassOf skos:Concept .

jl:NormativeStatus
    a owl:Class ;
    rdfs:label "Normative status"@en ;
    rdfs:comment "Whether an instrument is in force, pending, stalled or voluntary."@en ;
    rdfs:subClassOf skos:Concept .

jl:Jurisdiction
    a owl:Class ;
    rdfs:label "Jurisdiction"@en ;
    rdfs:comment "Where a law applies."@en ;
    rdfs:subClassOf schema:Place .

jl:playsRole
    a owl:ObjectProperty ;
    rdfs:label "plays role"@en ;
    rdfs:comment "Function the organization serves for the learner."@en ;
    rdfs:domain jl:Organization ;
    rdfs:range jl:OrganizationRole .

jl:targetProficiency
    a owl:ObjectProperty ;
    rdfs:label "target proficiency"@en ;
    rdfs:comment "How deeply to know it."@en ;
    rdfs:domain jl:LearningTarget ;
    rdfs:range jl:ProficiencyLevel .

jl:priorityTier
    a owl:ObjectProperty ;
    rdfs:label "priority tier"@en ;
    rdfs:comment "When to study it. Independent of target proficiency."@en ;
    rdfs:domain jl:LearningTarget ;
    rdfs:range jl:PriorityTier .

jl:inDomain
    a owl:ObjectProperty ;
    rdfs:label "in domain"@en ;
    rdfs:comment "Knowledge domain."@en ;
    rdfs:range jl:KnowledgeDomain .

jl:legalStatus
    a owl:ObjectProperty ;
    rdfs:label "normative status"@en ;
    rdfs:comment "Status in the Career Guide status key."@en ;
    rdfs:domain jl:Instrument ;
    rdfs:range jl:NormativeStatus .

jl:jurisdiction
    a owl:ObjectProperty ;
    rdfs:label "jurisdiction"@en ;
    rdfs:comment "Where the law applies."@en ;
    rdfs:domain jl:Law ;
    rdfs:range jl:Jurisdiction .

jl:issuedBy
    a owl:ObjectProperty ;
    rdfs:label "issued by"@en ;
    rdfs:comment "Who issued or owns it."@en ;
    rdfs:domain jl:Instrument ;
    rdfs:range jl:Organization .

jl:administeredBy
    a owl:ObjectProperty ;
    rdfs:label "administered by"@en ;
    rdfs:comment "Who administers or enforces it."@en ;
    rdfs:domain jl:Law ;
    rdfs:range jl:Organization .

jl:memberOf
    a owl:ObjectProperty ;
    rdfs:label "member of"@en ;
    rdfs:comment "Membership of a consortium or initiative."@en ;
    rdfs:domain jl:Organization ;
    rdfs:range jl:Organization .

jl:partOf
    a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "part of"@en ;
    rdfs:comment "Organizational containment."@en ;
    rdfs:domain jl:Organization ;
    rdfs:range jl:Organization .

jl:informs
    a owl:ObjectProperty ;
    rdfs:label "informs"@en ;
    rdfs:comment "Provides input to without binding."@en ;
    rdfs:domain jl:LearningTarget ;
    rdfs:range jl:LearningTarget .

jl:expectedToReference
    a owl:ObjectProperty ;
    rdfs:label "expected to reference"@en ;
    rdfs:comment "A projection that a law will lean on this standard."@en ;
    rdfs:domain jl:Law ;
    rdfs:range jl:LearningTarget .

jl:implements
    a owl:ObjectProperty ;
    rdfs:label "implements"@en ;
    rdfs:comment "Operates within or gives effect to."@en ;
    rdfs:domain jl:Instrument ;
    rdfs:range jl:Instrument .

jl:usesStandard
    a owl:ObjectProperty ;
    rdfs:label "uses standard"@en ;
    rdfs:comment "Relies on a standard."@en ;
    rdfs:domain jl:LearningTarget ;
    rdfs:range jl:Standard .

jl:builtOn
    a owl:ObjectProperty ;
    rdfs:label "built on"@en ;
    rdfs:comment "Technical dependency between standards."@en ;
    rdfs:domain jl:Standard ;
    rdfs:range jl:Standard .

jl:alignedWith
    a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:label "aligned with"@en ;
    rdfs:comment "Documented mapping between vocabularies."@en ;
    rdfs:domain jl:Standard ;
    rdfs:range jl:Standard .

jl:prerequisiteFor
    a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "prerequisite for"@en ;
    rdfs:comment "Learn the subject before the object."@en ;
    rdfs:domain jl:LearningTarget ;
    rdfs:range jl:LearningTarget .

jl:relatedTo
    a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:label "related to"@en ;
    rdfs:comment "Loose association."@en ;
    rdfs:domain jl:LearningTarget ;
    rdfs:range jl:LearningTarget ;
    rdfs:subPropertyOf skos:related .

jl:addressesProblem
    a owl:ObjectProperty ;
    rdfs:label "addresses problem"@en ;
    rdfs:comment "Where to start for a problem."@en ;
    rdfs:domain jl:LearningTarget ;
    rdfs:range jl:Problem .

jl:contrasts
    a owl:ObjectProperty ;
    rdfs:label "contrasts"@en ;
    rdfs:comment "The things being told apart."@en ;
    rdfs:domain jl:Distinction ;
    rdfs:range jl:LearningTarget .

jl:requires
    a owl:ObjectProperty ;
    rdfs:label "requires"@en ;
    rdfs:comment "Skill the requirement calls for."@en ;
    rdfs:domain jl:JobRequirement ;
    rdfs:range jl:Skill .

jl:requiresKnowledgeOf
    a owl:ObjectProperty ;
    rdfs:label "requires knowledge of"@en ;
    rdfs:comment "What to know to have the skill."@en ;
    rdfs:domain jl:Skill ;
    rdfs:range jl:LearningTarget .

jl:demonstrates
    a owl:ObjectProperty ;
    rdfs:label "demonstrates"@en ;
    rdfs:comment "Skill evidenced by a deliverable."@en ;
    rdfs:domain jl:Deliverable ;
    rdfs:range jl:Skill .

jl:buildsOn
    a owl:ObjectProperty ;
    rdfs:label "builds on"@en ;
    rdfs:comment "Deliverable dependency."@en ;
    rdfs:domain jl:Deliverable ;
    rdfs:range jl:Deliverable .

jl:targets
    a owl:ObjectProperty ;
    rdfs:label "targets"@en ;
    rdfs:comment "Organization the deliverable is aimed at."@en ;
    rdfs:domain jl:Deliverable ;
    rdfs:range jl:Organization .

jl:describes
    a owl:ObjectProperty ;
    rdfs:label "describes"@en ;
    rdfs:comment "Subject of a resource."@en ;
    rdfs:domain jl:Resource ;
    rdfs:range jl:LearningTarget .

jl:milestoneOf
    a owl:ObjectProperty ;
    rdfs:label "milestone of"@en ;
    rdfs:comment "Instrument whose lifecycle the milestone belongs to."@en ;
    rdfs:domain jl:Milestone ;
    rdfs:range jl:Instrument .

jl:operationalizedAs
    a owl:AnnotationProperty ;
    rdfs:label "operationalized as"@en ;
    rdfs:comment "Domain-seed class this learning target shapes."@en ;
    rdfs:domain jl:LearningTarget .

jl:plainEnglish
    a owl:DatatypeProperty ;
    rdfs:label "plain English"@en ;
    rdfs:comment "One-line explanation."@en ;
    rdfs:range xsd:string .

jl:keyQuestion
    a owl:DatatypeProperty ;
    rdfs:label "key question"@en ;
    rdfs:comment "Question the distinction answers."@en ;
    rdfs:range xsd:string .

jl:fashionTranslation
    a owl:DatatypeProperty ;
    rdfs:label "fashion translation"@en ;
    rdfs:comment "How the job requirement reads in fashion."@en ;
    rdfs:range xsd:string .

jl:readiness
    a owl:DatatypeProperty ;
    rdfs:label "readiness"@en ;
    rdfs:comment "Where the learner stands: Evidence, Building, Planned, Reframe, Not started, Not applicable."@en ;
    rdfs:range xsd:string .

jl:readinessNote
    a owl:DatatypeProperty ;
    rdfs:label "readiness note"@en ;
    rdfs:comment "Detail for readiness."@en ;
    rdfs:range xsd:string .

jl:requirementLevel
    a owl:DatatypeProperty ;
    rdfs:label "requirement level"@en ;
    rdfs:comment "Required or Nice to have."@en ;
    rdfs:range xsd:string .

jl:deliverableStatus
    a owl:DatatypeProperty ;
    rdfs:label "deliverable status"@en ;
    rdfs:comment "Done, In progress, Planned or Suggested."@en ;
    rdfs:range xsd:string .

jl:standardKind
    a owl:DatatypeProperty ;
    rdfs:label "standard kind"@en ;
    rdfs:comment "Identifier, data exchange, vocabulary, certification and so on."@en ;
    rdfs:range xsd:string .

jl:resourceType
    a owl:DatatypeProperty ;
    rdfs:label "resource type"@en ;
    rdfs:comment "Notes, Web, Training or Event."@en ;
    rdfs:range xsd:string .

jl:proficiencyScope
    a owl:DatatypeProperty ;
    rdfs:label "proficiency scope"@en ;
    rdfs:comment "Qualifier on target proficiency, such as 'in the DPP context'."@en ;
    rdfs:range xsd:string .

jl:date
    a owl:DatatypeProperty ;
    rdfs:label "date"@en ;
    rdfs:comment "ISO date, month or year. Precision varies."@en ;
    rdfs:range xsd:string .

jl:isProjection
    a owl:DatatypeProperty ;
    rdfs:label "is projection"@en ;
    rdfs:comment "True when the date is a projection."@en ;
    rdfs:range xsd:boolean .

jl:needsVerification
    a owl:DatatypeProperty ;
    rdfs:label "needs verification"@en ;
    rdfs:comment "True when the source notes flag the item as unconfirmed, or when verification here failed."@en ;
    rdfs:range xsd:boolean .

jl:targetEmployer
    a owl:DatatypeProperty ;
    rdfs:label "target employer"@en ;
    rdfs:comment "True when the company is a stated career target."@en ;
    rdfs:range xsd:boolean .

jl:OrganizationRoleScheme
    a skos:ConceptScheme ;
    rdfs:label "OrganizationRole scheme"@en .

jl:RuleMaker
    a jl:OrganizationRole ;
    rdfs:label "Rule Maker"@en ;
    rdfs:comment "Defines or informs the rules"@en ;
    skos:inScheme jl:OrganizationRoleScheme .

jl:DataLanguageMaker
    a jl:OrganizationRole ;
    rdfs:label "Data Language Maker"@en ;
    rdfs:comment "Defines the data language"@en ;
    skos:inScheme jl:OrganizationRoleScheme .

jl:ClaimVerifier
    a jl:OrganizationRole ;
    rdfs:label "Claim Verifier"@en ;
    rdfs:comment "Verifies sustainability claims"@en ;
    skos:inScheme jl:OrganizationRoleScheme .

jl:IndustryVoice
    a jl:OrganizationRole ;
    rdfs:label "Industry Voice"@en ;
    rdfs:comment "Shows what the industry needs"@en ;
    skos:inScheme jl:OrganizationRoleScheme .

jl:MarketActor
    a jl:OrganizationRole ;
    rdfs:label "Market Actor"@en ;
    rdfs:comment "Buys, sells, supplies or tests: brands, vendors, labs"@en ;
    skos:inScheme jl:OrganizationRoleScheme .

jl:ProficiencyLevelScheme
    a skos:ConceptScheme ;
    rdfs:label "ProficiencyLevel scheme"@en .

jl:DeepExpertise
    a jl:ProficiencyLevel ;
    rdfs:label "Deep Expertise"@en ;
    rdfs:comment "Explain the role, find the authoritative documents, interpret the relevant parts, apply to a product-data problem"@en ;
    skos:inScheme jl:ProficiencyLevelScheme .

jl:WorkingLiteracy
    a jl:ProficiencyLevel ;
    rdfs:label "Working Literacy"@en ;
    rdfs:comment "Understand what it does, know the main concepts, find the right document when a project needs it"@en ;
    skos:inScheme jl:ProficiencyLevelScheme .

jl:CasualMonitoring
    a jl:ProficiencyLevel ;
    rdfs:label "Casual Monitoring"@en ;
    rdfs:comment "Recognise important developments without regular study time"@en ;
    skos:inScheme jl:ProficiencyLevelScheme .

jl:PriorityTierScheme
    a skos:ConceptScheme ;
    rdfs:label "PriorityTier scheme"@en .

jl:Tier1
    a jl:PriorityTier ;
    rdfs:label "Tier 1"@en ;
    rdfs:comment "Build real expertise"@en ;
    skos:inScheme jl:PriorityTierScheme .

jl:Tier2
    a jl:PriorityTier ;
    rdfs:label "Tier 2"@en ;
    rdfs:comment "Become comfortably conversant"@en ;
    skos:inScheme jl:PriorityTierScheme .

jl:Tier3
    a jl:PriorityTier ;
    rdfs:label "Tier 3"@en ;
    rdfs:comment "Monitor selectively"@en ;
    skos:inScheme jl:PriorityTierScheme .

jl:NormativeStatusScheme
    a skos:ConceptScheme ;
    rdfs:label "NormativeStatus scheme"@en .

jl:InForce
    a jl:NormativeStatus ;
    rdfs:label "In Force"@en ;
    rdfs:comment "Applies now"@en ;
    skos:inScheme jl:NormativeStatusScheme .

jl:EnactedNotYetApplicable
    a jl:NormativeStatus ;
    rdfs:label "Enacted Not Yet Applicable"@en ;
    rdfs:comment "Law exists; rules or dates are pending"@en ;
    skos:inScheme jl:NormativeStatusScheme .

jl:ProposedOrStalled
    a jl:NormativeStatus ;
    rdfs:label "Proposed Or Stalled"@en ;
    rdfs:comment "Do not build on it"@en ;
    skos:inScheme jl:NormativeStatusScheme .

jl:Voluntary
    a jl:NormativeStatus ;
    rdfs:label "Voluntary"@en ;
    rdfs:comment "Not law"@en ;
    skos:inScheme jl:NormativeStatusScheme .

jl:KnowledgeDomainScheme
    a skos:ConceptScheme ;
    rdfs:label "KnowledgeDomain scheme"@en .

jl:ProductDataStandards
    a jl:KnowledgeDomain ;
    rdfs:label "A. Product data standards"@en ;
    rdfs:comment "A. Product data standards"@en ;
    skos:inScheme jl:KnowledgeDomainScheme .

jl:RegulationAndReporting
    a jl:KnowledgeDomain ;
    rdfs:label "B. Sustainability regulation and reporting"@en ;
    rdfs:comment "B. Sustainability regulation and reporting"@en ;
    skos:inScheme jl:KnowledgeDomainScheme .

jl:PrivateStandardsAndCertification
    a jl:KnowledgeDomain ;
    rdfs:label "C. Private fashion and materials standards"@en ;
    rdfs:comment "C. Private fashion and materials standards"@en ;
    skos:inScheme jl:KnowledgeDomainScheme .

jl:DataQualityAndGovernance
    a jl:KnowledgeDomain ;
    rdfs:label "D. Data quality and governance"@en ;
    rdfs:comment "D. Data quality and governance"@en ;
    skos:inScheme jl:KnowledgeDomainScheme .

jl:IndustryAndTradeBodies
    a jl:KnowledgeDomain ;
    rdfs:label "E. Industry and trade bodies"@en ;
    rdfs:comment "E. Industry and trade bodies"@en ;
    skos:inScheme jl:KnowledgeDomainScheme .

jl:SemanticTechnologies
    a jl:KnowledgeDomain ;
    rdfs:label "F. Semantic technologies and ontology practice"@en ;
    rdfs:comment "F. Semantic technologies and ontology practice"@en ;
    skos:inScheme jl:KnowledgeDomainScheme .

jl:TraceabilityProvenanceEvidence
    a jl:KnowledgeDomain ;
    rdfs:label "G. Traceability, provenance and evidence"@en ;
    rdfs:comment "G. Traceability, provenance and evidence"@en ;
    skos:inScheme jl:KnowledgeDomainScheme .

jl:CareerAndCapstone
    a jl:KnowledgeDomain ;
    rdfs:label "H. Career and capstone"@en ;
    rdfs:comment "H. Career and capstone"@en ;
    skos:inScheme jl:KnowledgeDomainScheme .

fd:Party
    a owl:Class ;
    rdfs:label "Party"@en ;
    rdfs:comment "Any organisation that acts: a brand, supplier, certifier, laboratory."@en .

fd:Brand
    a owl:Class ;
    rdfs:label "Brand"@en ;
    rdfs:comment "The house that owns the product and makes claims about it."@en ;
    rdfs:subClassOf fd:Party , schema:Organization .

fd:Supplier
    a owl:Class ;
    rdfs:label "Supplier"@en ;
    rdfs:comment "Operates facilities and supplies materials or processing."@en ;
    rdfs:subClassOf fd:Party .

fd:Certifier
    a owl:Class ;
    rdfs:label "Certifier"@en ;
    rdfs:comment "Issues certificates or conducts assessments."@en ;
    rdfs:subClassOf fd:Party .

fd:TestingLab
    a owl:Class ;
    rdfs:label "Testing laboratory"@en ;
    rdfs:comment "Runs standardised test methods."@en ;
    rdfs:subClassOf fd:Party .

fd:Facility
    a owl:Class ;
    rdfs:label "Facility"@en ;
    rdfs:comment "A production location. Identified by OS ID or GLN. Reconcile name variants before merging."@en ;
    rdfs:subClassOf schema:Place .

fd:ProductModel
    a owl:Class ;
    rdfs:label "Product model (style)"@en ;
    rdfs:comment "Style-level record, such as style 382602."@en ;
    rdfs:subClassOf schema:Product .

fd:TradeItem
    a owl:Class ;
    rdfs:label "Trade item (GTIN level)"@en ;
    rdfs:comment "Style, colour and size combination that carries a GTIN."@en ;
    rdfs:subClassOf schema:Product .

fd:SerialisedItem
    a owl:Class ;
    rdfs:label "Serialised item"@en ;
    rdfs:comment "One physical unit. Level at which an item-level DPP attaches."@en ;
    rdfs:subClassOf schema:Product .

fd:Material
    a owl:Class ;
    rdfs:label "Material"@en ;
    rdfs:comment "A fiber, fabric or component material."@en ;
    rdfs:subClassOf owl:Thing .

fd:MaterialComposition
    a owl:Class ;
    rdfs:label "Material composition"@en ;
    rdfs:comment "One material and its share of a product. Maps to gs1:TextileMaterialDetails."@en ;
    rdfs:subClassOf owl:Thing .

fd:Lot
    a owl:Class ;
    rdfs:label "Lot or batch"@en ;
    rdfs:comment "A batch of material or product with shared history."@en ;
    rdfs:subClassOf owl:Thing .

fd:SupplyChainEvent
    a owl:Class ;
    rdfs:label "Supply-chain event"@en ;
    rdfs:comment "What, where, when and why, as in EPCIS."@en ;
    rdfs:subClassOf schema:Event .

fd:Evidence
    a owl:Class ;
    rdfs:label "Evidence"@en ;
    rdfs:comment "Anything that supports a claim, with source, scope, date and verification."@en ;
    rdfs:subClassOf owl:Thing .

fd:Certificate
    a owl:Class ;
    rdfs:label "Certificate"@en ;
    rdfs:comment "Issued under a scheme to a scope with a validity period."@en ;
    rdfs:subClassOf fd:Evidence ;
    rdfs:seeAlso jl:CertificationScheme .

fd:TestResult
    a owl:Class ;
    rdfs:label "Test result"@en ;
    rdfs:comment "Method, laboratory, date and result."@en ;
    rdfs:subClassOf fd:Evidence .

fd:Assessment
    a owl:Class ;
    rdfs:label "Assessment"@en ;
    rdfs:comment "Facility assessment with findings and corrective actions."@en ;
    rdfs:subClassOf fd:Evidence .

fd:Claim
    a owl:Class ;
    rdfs:label "Claim"@en ;
    rdfs:comment "A statement about a material, item or facility. Not proof."@en ;
    rdfs:subClassOf owl:Thing .

fd:SupplierDeclaration
    a owl:Class ;
    rdfs:label "Supplier declaration"@en ;
    rdfs:comment "A supplier's own statement. Weak until supported."@en ;
    rdfs:subClassOf fd:Claim .

fd:Verification
    a owl:Class ;
    rdfs:label "Verification"@en ;
    rdfs:comment "Who checked which evidence, when and how."@en ;
    rdfs:subClassOf schema:Event .

fd:ComplianceRequirement
    a owl:Class ;
    rdfs:label "Compliance requirement"@en ;
    rdfs:comment "What a law demands for which product, market and date."@en ;
    rdfs:subClassOf owl:Thing .

fd:DigitalProductPassport
    a owl:Class ;
    rdfs:label "Digital Product Passport"@en ;
    rdfs:comment "An aggregated view over product data, carried by a resolvable identifier. Not a new database."@en ;
    rdfs:subClassOf owl:Thing .

fd:brandOf
    a owl:ObjectProperty ;
    rdfs:label "brandOf"@en ;
    rdfs:comment "Brand that owns the style."@en ;
    rdfs:domain fd:ProductModel ;
    rdfs:range fd:Brand .

fd:hasVariant
    a owl:ObjectProperty ;
    rdfs:label "hasVariant"@en ;
    rdfs:comment "Style to GTIN-level items."@en ;
    rdfs:domain fd:ProductModel ;
    rdfs:range fd:TradeItem .

fd:hasUnit
    a owl:ObjectProperty ;
    rdfs:label "hasUnit"@en ;
    rdfs:comment "GTIN-level item to individual units."@en ;
    rdfs:domain fd:TradeItem ;
    rdfs:range fd:SerialisedItem .

fd:hasComposition
    a owl:ObjectProperty ;
    rdfs:label "hasComposition"@en ;
    rdfs:comment "Declared composition."@en ;
    rdfs:domain fd:TradeItem ;
    rdfs:range fd:MaterialComposition .

fd:ofMaterial
    a owl:ObjectProperty ;
    rdfs:label "ofMaterial"@en ;
    rdfs:comment "Which material."@en ;
    rdfs:domain fd:MaterialComposition ;
    rdfs:range fd:Material .

fd:madeFromLot
    a owl:ObjectProperty ;
    rdfs:label "madeFromLot"@en ;
    rdfs:comment "Production lot behind the item."@en ;
    rdfs:domain fd:TradeItem ;
    rdfs:range fd:Lot .

fd:lotOfMaterial
    a owl:ObjectProperty ;
    rdfs:label "lotOfMaterial"@en ;
    rdfs:comment "Material contained in the lot."@en ;
    rdfs:domain fd:Lot ;
    rdfs:range fd:Material .

fd:producedAt
    a owl:ObjectProperty ;
    rdfs:label "producedAt"@en ;
    rdfs:comment "Where the lot was produced."@en ;
    rdfs:domain fd:Lot ;
    rdfs:range fd:Facility .

fd:operatedBy
    a owl:ObjectProperty ;
    rdfs:label "operatedBy"@en ;
    rdfs:comment "Who runs the facility."@en ;
    rdfs:domain fd:Facility ;
    rdfs:range fd:Supplier .

fd:concerns
    a owl:ObjectProperty ;
    rdfs:label "concerns"@en ;
    rdfs:comment "What the event is about."@en ;
    rdfs:domain fd:SupplyChainEvent ;
    rdfs:range fd:Lot .

fd:atFacility
    a owl:ObjectProperty ;
    rdfs:label "atFacility"@en ;
    rdfs:comment "Where it happened."@en ;
    rdfs:domain fd:SupplyChainEvent ;
    rdfs:range fd:Facility .

fd:issuedBy
    a owl:ObjectProperty ;
    rdfs:label "issuedBy"@en ;
    rdfs:comment "Issuing organisation."@en ;
    rdfs:domain fd:Certificate ;
    rdfs:range fd:Certifier .

fd:coversFacility
    a owl:ObjectProperty ;
    rdfs:label "coversFacility"@en ;
    rdfs:comment "Scope: facilities."@en ;
    rdfs:domain fd:Certificate ;
    rdfs:range fd:Facility .

fd:coversMaterial
    a owl:ObjectProperty ;
    rdfs:label "coversMaterial"@en ;
    rdfs:comment "Scope: materials."@en ;
    rdfs:domain fd:Certificate ;
    rdfs:range fd:Material .

fd:aboutMaterial
    a owl:ObjectProperty ;
    rdfs:label "aboutMaterial"@en ;
    rdfs:comment "What the claim is about."@en ;
    rdfs:domain fd:Claim ;
    rdfs:range fd:Material .

fd:aboutItem
    a owl:ObjectProperty ;
    rdfs:label "aboutItem"@en ;
    rdfs:comment "What the claim is about."@en ;
    rdfs:domain fd:Claim ;
    rdfs:range fd:TradeItem .

fd:assertedBy
    a owl:ObjectProperty ;
    rdfs:label "assertedBy"@en ;
    rdfs:comment "Who makes the claim."@en ;
    rdfs:domain fd:Claim ;
    rdfs:range fd:Party .

fd:supportedBy
    a owl:ObjectProperty ;
    rdfs:label "supportedBy"@en ;
    rdfs:comment "What supports it."@en ;
    rdfs:domain fd:Claim ;
    rdfs:range fd:Evidence .

fd:verifies
    a owl:ObjectProperty ;
    rdfs:label "verifies"@en ;
    rdfs:comment "What was checked."@en ;
    rdfs:domain fd:Verification ;
    rdfs:range fd:Evidence .

fd:performedBy
    a owl:ObjectProperty ;
    rdfs:label "performedBy"@en ;
    rdfs:comment "Who checked it."@en ;
    rdfs:domain fd:Verification ;
    rdfs:range fd:Party .

fd:testedBy
    a owl:ObjectProperty ;
    rdfs:label "testedBy"@en ;
    rdfs:comment "Laboratory."@en ;
    rdfs:domain fd:TestResult ;
    rdfs:range fd:TestingLab .

fd:testedOn
    a owl:ObjectProperty ;
    rdfs:label "testedOn"@en ;
    rdfs:comment "Tested material."@en ;
    rdfs:domain fd:TestResult ;
    rdfs:range fd:Material .

fd:assesses
    a owl:ObjectProperty ;
    rdfs:label "assesses"@en ;
    rdfs:comment "Assessed facility."@en ;
    rdfs:domain fd:Assessment ;
    rdfs:range fd:Facility .

fd:describes
    a owl:ObjectProperty ;
    rdfs:label "describes"@en ;
    rdfs:comment "Item the passport is attached to."@en ;
    rdfs:domain fd:DigitalProductPassport ;
    rdfs:range fd:SerialisedItem .

fd:aggregates
    a owl:ObjectProperty ;
    rdfs:label "aggregates"@en ;
    rdfs:comment "Evidence surfaced in the passport."@en ;
    rdfs:domain fd:DigitalProductPassport ;
    rdfs:range fd:Evidence .

fd:requiresEvidence
    a owl:ObjectProperty ;
    rdfs:label "requiresEvidence"@en ;
    rdfs:comment "Evidence the law demands."@en ;
    rdfs:domain fd:ComplianceRequirement ;
    rdfs:range fd:Evidence .

fd:gtin
    a owl:DatatypeProperty ;
    rdfs:label "gtin"@en ;
    rdfs:comment "14-digit Global Trade Item Number."@en ;
    rdfs:domain fd:TradeItem ;
    rdfs:range xsd:string .

fd:osId
    a owl:DatatypeProperty ;
    rdfs:label "osId"@en ;
    rdfs:comment "Open Supply Hub ID."@en ;
    rdfs:domain fd:Facility ;
    rdfs:range xsd:string .

fd:glnCode
    a owl:DatatypeProperty ;
    rdfs:label "glnCode"@en ;
    rdfs:comment "Global Location Number."@en ;
    rdfs:domain fd:Facility ;
    rdfs:range xsd:string .

fd:percentage
    a owl:DatatypeProperty ;
    rdfs:label "percentage"@en ;
    rdfs:comment "Net weight share of the material."@en ;
    rdfs:domain fd:MaterialComposition ;
    rdfs:range xsd:decimal .

fd:certificateNumber
    a owl:DatatypeProperty ;
    rdfs:label "certificateNumber"@en ;
    rdfs:comment "Certificate identifier."@en ;
    rdfs:domain fd:Certificate ;
    rdfs:range xsd:string .

fd:validFrom
    a owl:DatatypeProperty ;
    rdfs:label "validFrom"@en ;
    rdfs:comment "Start of validity."@en ;
    rdfs:domain fd:Certificate ;
    rdfs:range xsd:date .

fd:validTo
    a owl:DatatypeProperty ;
    rdfs:label "validTo"@en ;
    rdfs:comment "End of validity."@en ;
    rdfs:domain fd:Certificate ;
    rdfs:range xsd:date .

fd:countryOfOrigin
    a owl:DatatypeProperty ;
    rdfs:label "countryOfOrigin"@en ;
    rdfs:comment "Declared origin; needs evidence."@en ;
    rdfs:domain fd:TradeItem ;
    rdfs:range xsd:string .

fd:eventTime
    a owl:DatatypeProperty ;
    rdfs:label "eventTime"@en ;
    rdfs:comment "When."@en ;
    rdfs:domain fd:SupplyChainEvent ;
    rdfs:range xsd:dateTime .

fd:businessStep
    a owl:DatatypeProperty ;
    rdfs:label "businessStep"@en ;
    rdfs:comment "Why: the business step."@en ;
    rdfs:domain fd:SupplyChainEvent ;
    rdfs:range xsd:string .

fd:testMethod
    a owl:DatatypeProperty ;
    rdfs:label "testMethod"@en ;
    rdfs:comment "Standardised method identifier."@en ;
    rdfs:domain fd:TestResult ;
    rdfs:range xsd:string .

fd:resultValue
    a owl:DatatypeProperty ;
    rdfs:label "resultValue"@en ;
    rdfs:comment "Result."@en ;
    rdfs:domain fd:TestResult ;
    rdfs:range xsd:string .

fd:verificationDate
    a owl:DatatypeProperty ;
    rdfs:label "verificationDate"@en ;
    rdfs:comment "Date checked."@en ;
    rdfs:domain fd:Verification ;
    rdfs:range xsd:date .

fd:verificationMethod
    a owl:DatatypeProperty ;
    rdfs:label "verificationMethod"@en ;
    rdfs:comment "How it was checked."@en ;
    rdfs:domain fd:Verification ;
    rdfs:range xsd:string .

fd:underScheme
    a owl:ObjectProperty ;
    rdfs:label "underScheme"@en ;
    rdfs:comment "Certification scheme (learning layer) under which a certificate is issued."@en ;
    rdfs:domain fd:Certificate ;
    rdfs:range jl:CertificationScheme .

fd:basedOn
    a owl:ObjectProperty ;
    rdfs:label "basedOn"@en ;
    rdfs:comment "Law (learning layer) behind a compliance requirement."@en ;
    rdfs:domain fd:ComplianceRequirement ;
    rdfs:range jl:Law .

fd:usesMethod
    a owl:ObjectProperty ;
    rdfs:label "usesMethod"@en ;
    rdfs:comment "Standard (learning layer) whose test method produced a result."@en ;
    rdfs:domain fd:TestResult ;
    rdfs:range jl:Standard .

