    dcterms:source "Reference Guide / Career Guide / job description" ;
    jl:inDomain jl:RegulationAndReporting .

id:entityres
    a jl:Concept ;
    rdfs:label "Entity resolution"@en ;
    jl:plainEnglish "Deciding whether two records describe the same real-world thing, such as one factory under three names."@en ;
    dcterms:source "Reference Guide / Career Guide / job description" ;
    jl:inDomain jl:TraceabilityProvenanceEvidence ;
    jl:prerequisiteFor id:osid ;
    jl:operationalizedAs fd:Facility .

id:origin
    a jl:Concept ;
    rdfs:label "Country of origin"@en ;
    jl:plainEnglish "Origin, place of last processing step and evidence for an origin claim are related but not interchangeable."@en ;
    dcterms:source "Reference Guide / Career Guide / job description" ;
    jl:inDomain jl:TraceabilityProvenanceEvidence ;
    jl:operationalizedAs fd:Claim .

id:substantiation
    a jl:Concept ;
    rdfs:label "Substantiation"@en ;
    jl:plainEnglish "Evidence a company holds to back an environmental claim."@en ;
    dcterms:source "Reference Guide / Career Guide / job description" ;
    jl:inDomain jl:RegulationAndReporting ;
    jl:operationalizedAs fd:Claim .

id:dist_espr_dpp
    a jl:Distinction ;
    rdfs:label "ESPR vs DPP"@en ;
    jl:plainEnglish "ESPR is the legal framework. A DPP is a product-specific digital information mechanism defined through the applicable legal framework."@en ;
    dcterms:source "Reference Guide, 'study by heart' and distinction boxes" ;
    jl:inDomain jl:TraceabilityProvenanceEvidence ;
    jl:targetProficiency jl:DeepExpertise ;
    jl:keyQuestion "Which one is the law and which one is the mechanism?" ;
    jl:contrasts id:espr , id:dpp .

id:dist_csrd_esrs
    a jl:Distinction ;
    rdfs:label "CSRD vs ESRS"@en ;
    jl:plainEnglish "CSRD is the corporate reporting directive. ESRS are the standards used within its framework, subject to scope."@en ;
    dcterms:source "Reference Guide, 'study by heart' and distinction boxes" ;
    jl:inDomain jl:TraceabilityProvenanceEvidence ;
    jl:targetProficiency jl:DeepExpertise ;
    jl:keyQuestion "Which is the directive and which are the reporting standards?" ;
    jl:contrasts id:csrd , id:esrs .

id:dist_jrc_law
    a jl:Distinction ;
    rdfs:label "JRC research vs law"@en ;
    jl:plainEnglish "Scientific recommendations can inform legal requirements. A research report is not itself binding."@en ;
    dcterms:source "Reference Guide, 'study by heart' and distinction boxes" ;
    jl:inDomain jl:TraceabilityProvenanceEvidence ;
    jl:targetProficiency jl:DeepExpertise ;
    jl:keyQuestion "Can a research recommendation bind a company?" ;
    jl:contrasts id:jrcstudy , id:espr_textile .

id:dist_trace_dd
    a jl:Distinction ;
    rdfs:label "Traceability vs due diligence"@en ;
    jl:plainEnglish "Traceability shows where products and materials came from and how they moved. Due diligence is the wider process of identifying, preventing, mitigating and addressing adverse impacts."@en ;
    dcterms:source "Reference Guide, 'study by heart' and distinction boxes" ;
    jl:inDomain jl:TraceabilityProvenanceEvidence ;
    jl:targetProficiency jl:DeepExpertise ;
    jl:keyQuestion "Where did it come from, versus what harm did we address?" ;
    jl:contrasts id:traceability , id:duediligence .

id:dist_evidence_claim
    a jl:Distinction ;
    rdfs:label "Evidence vs assertion"@en ;
    jl:plainEnglish "A supplier's statement is a claim. Its reliability depends on context, supporting evidence, verification and the applicable requirement."@en ;
    dcterms:source "Reference Guide, 'study by heart' and distinction boxes" ;
    jl:inDomain jl:TraceabilityProvenanceEvidence ;
    jl:targetProficiency jl:DeepExpertise ;
    jl:keyQuestion "Is this a statement or something that supports one?" ;
    jl:contrasts id:evidence , id:claim ;
    jl:operationalizedAs fd:Claim , fd:Evidence .

id:dist_committees
    a jl:Distinction ;
    rdfs:label "JTC 24 vs ISO/IEC JTC 5 vs the Commission"@en ;
    jl:plainEnglish "The Commission sets the legal framework. CEN-CENELEC JTC 24 and ISO/IEC JTC 5 work on technical standards in different standardisation systems."@en ;
    dcterms:source "Reference Guide, 'study by heart' and distinction boxes" ;
    jl:inDomain jl:TraceabilityProvenanceEvidence ;
    jl:targetProficiency jl:DeepExpertise ;
    jl:keyQuestion "Who writes what?" ;
    jl:contrasts id:jtc24 , id:isoiecjtc5 , id:eucom .

id:dist_cascale_worldly
    a jl:Distinction ;
    rdfs:label "Cascale vs Worldly"@en ;
    jl:plainEnglish "Cascale develops industry frameworks and convenes. Worldly provides software and data solutions used to support assessments."@en ;
    dcterms:source "Reference Guide, 'study by heart' and distinction boxes" ;
    jl:inDomain jl:TraceabilityProvenanceEvidence ;
    jl:targetProficiency jl:DeepExpertise ;
    jl:keyQuestion "Framework owner or data platform?" ;
    jl:contrasts id:cascale , id:worldly .

id:dist_schema_model
    a jl:Distinction ;
    rdfs:label "Schema vs data model vs data dictionary"@en ;
    jl:plainEnglish "A data model is the blueprint. A schema is the enforceable contract. A data dictionary explains each field. A taxonomy is hierarchical; an ontology adds relationships and rules."@en ;
    dcterms:source "Reference Guide, 'study by heart' and distinction boxes" ;
    jl:inDomain jl:TraceabilityProvenanceEvidence ;
    jl:targetProficiency jl:DeepExpertise ;
    jl:keyQuestion "Blueprint, contract or reference?" ;
    jl:contrasts id:schema , id:datamodel , id:datadictionary , id:taxonomy , id:ontology .

id:dist_prov_lineage_coc
    a jl:Distinction ;
    rdfs:label "Provenance vs lineage vs chain of custody"@en ;
    jl:plainEnglish "Provenance is how data was produced. Lineage is how it moved across systems. Chain of custody records who handled it, when and why."@en ;
    dcterms:source "Reference Guide, 'study by heart' and distinction boxes" ;
    jl:inDomain jl:TraceabilityProvenanceEvidence ;
    jl:targetProficiency jl:DeepExpertise ;
    jl:keyQuestion "History, system trail or people trail?" ;
    jl:contrasts id:provenance , id:lineage , id:chainofcustody .

id:dist_product_event
    a jl:Distinction ;
    rdfs:label "Identifying a product vs recording its journey"@en ;
    jl:plainEnglish "GTIN identifies the product type. EPCIS records an event in its journey. Do not merge them."@en ;
    dcterms:source "Reference Guide, 'study by heart' and distinction boxes" ;
    jl:inDomain jl:TraceabilityProvenanceEvidence ;
    jl:targetProficiency jl:DeepExpertise ;
    jl:keyQuestion "Is this a what or a what-happened?" ;
    jl:contrasts id:gtin , id:epcis .

id:dist_law_standard
    a jl:Distinction ;
    rdfs:label "Law vs standard vs certificate"@en ;
    jl:plainEnglish "Standards are voluntary unless (1) a law points to them, (2) a customer contract demands them or (3) they serve as evidence for a green claim."@en ;
    dcterms:source "Reference Guide, 'study by heart' and distinction boxes" ;
    jl:inDomain jl:TraceabilityProvenanceEvidence ;
    jl:targetProficiency jl:DeepExpertise ;
    jl:keyQuestion "When does a voluntary standard become required?" ;
    jl:contrasts id:textilelabelling , id:iso22095 , id:oekostd100 .

id:dist_origin
    a jl:Distinction ;
    rdfs:label "Origin vs last processing step vs origin evidence"@en ;
    jl:plainEnglish "Related but not interchangeable. An origin claim needs supporting evidence."@en ;
    dcterms:source "Reference Guide, 'study by heart' and distinction boxes" ;
    jl:inDomain jl:TraceabilityProvenanceEvidence ;
    jl:targetProficiency jl:DeepExpertise ;
    jl:keyQuestion "Which origin do you mean?" ;
    jl:contrasts id:origin , id:cbp_import .

id:dist_size
    a jl:Distinction ;
    rdfs:label "Size label vs garment vs body measurement"@en ;
    jl:plainEnglish "A size label, the garment's actual measurements and the body measurements it is designed to fit are three data points."@en ;
    dcterms:source "Reference Guide, 'study by heart' and distinction boxes" ;
    jl:inDomain jl:TraceabilityProvenanceEvidence ;
    jl:targetProficiency jl:DeepExpertise ;
    jl:keyQuestion "What does the number describe?" ;
    jl:contrasts id:isotc133 .

id:dist_impact_claim
    a jl:Distinction ;
    rdfs:label "Measured impact vs sustainability claim"@en ;
    jl:plainEnglish "A measured environmental impact (LCA) differs from a general sustainability claim, which needs substantiation under rules such as the anti-greenwashing directive."@en ;
    dcterms:source "Reference Guide, 'study by heart' and distinction boxes" ;
    jl:inDomain jl:TraceabilityProvenanceEvidence ;
    jl:targetProficiency jl:DeepExpertise ;
    jl:keyQuestion "Measured or merely asserted?" ;
    jl:contrasts id:lca , id:substantiation , id:ecgt .

id:dist_cert_scope
    a jl:Distinction ;
    rdfs:label "Certificate vs universal sustainability"@en ;
    jl:plainEnglish "Do not record Sustainable = Yes. Record the material, the scheme, the certificate and issuer, the covered facility, validity, the evidence linking it to this product, and the date and method of verification."@en ;
    dcterms:source "Reference Guide, 'study by heart' and distinction boxes" ;
    jl:inDomain jl:TraceabilityProvenanceEvidence ;
    jl:targetProficiency jl:DeepExpertise ;
    jl:keyQuestion "What exactly does this certificate cover?" ;
    jl:contrasts id:gots , id:claim , id:evidence ;
    jl:operationalizedAs fd:Certificate .

