    a jl:Jurisdiction ;
    rdfs:label "California"@en .

id:jur_EU
    a jl:Jurisdiction ;
    rdfs:label "EU"@en .

id:jur_France
    a jl:Jurisdiction ;
    rdfs:label "France"@en .

id:jur_US
    a jl:Jurisdiction ;
    rdfs:label "US"@en .

id:gs1
    a jl:StandardsBody ;
    rdfs:label "GS1"@en ;
    jl:plainEnglish "Common identification and data-sharing rules so different companies recognise the same product or location. Groups its work as identify, capture, share."@en ;
    schema:url <https://www.gs1.org> ;
    dcterms:source "Reference Guide, section A" ;
    jl:inDomain jl:ProductDataStandards ;
    jl:targetProficiency jl:DeepExpertise ;
    jl:priorityTier jl:Tier1 ;
    jl:playsRole jl:DataLanguageMaker ;
    jl:addressesProblem id:p_identify .

id:gs1us
    a jl:StandardsBody ;
    rdfs:label "GS1 US"@en ;
    jl:plainEnglish "US member organisation, headquartered in Ewing NJ, with an apparel and general merchandise community. Runs training and GS1 Connect."@en ;
    schema:url <https://www.gs1us.org> ;
    dcterms:source "Reference Guide, section A" ;
    jl:inDomain jl:ProductDataStandards ;
    jl:playsRole jl:DataLanguageMaker ;
    jl:partOf id:gs1 .

id:cencenelec
    a jl:StandardsBody ;
    rdfs:label "CEN-CENELEC"@en ;
    jl:plainEnglish "European standardisation organisations. Its SDG page maps standards to the 17 goals (SDG 12 lists 2,839 standards) and names no textile or DPP standards."@en ;
    schema:url <https://www.cencenelec.eu> ;
    dcterms:source "Reference Guide, section A" ;
    jl:inDomain jl:ProductDataStandards ;
    jl:playsRole jl:DataLanguageMaker .

id:jtc24
    a jl:StandardsCommittee ;
    rdfs:label "CEN-CENELEC JTC 24 (Digital Product Passport)"@en ;
    jl:plainEnglish "European committee writing DPP standards. Not the European Commission and not ISO/IEC JTC 5."@en ;
    schema:url <https://www.cencenelec.eu> ;
    dcterms:source "Reference Guide, section A" ;
    jl:inDomain jl:ProductDataStandards ;
    jl:targetProficiency jl:DeepExpertise ;
    jl:proficiencyScope "in the DPP context" ;
    jl:priorityTier jl:Tier1 ;
    jl:playsRole jl:DataLanguageMaker ;
    jl:partOf id:cencenelec ;
    jl:addressesProblem id:p_dpp .

id:isoiecjtc5
    a jl:StandardsCommittee ;
    rdfs:label "ISO/IEC JTC 5 (Digital Product Passport)"@en ;
    jl:plainEnglish "Cross-sector and cross-system DPP interoperability. A different standardisation system from CEN-CENELEC JTC 24; monitor both."@en ;
    schema:url <https://www.iso.org/committee/11760382.html> ;
    dcterms:source "Reference Guide, section A" ;
    jl:inDomain jl:ProductDataStandards ;
    jl:priorityTier jl:Tier1 ;
    jl:playsRole jl:DataLanguageMaker ;
    jl:partOf id:iso , id:iec ;
    jl:addressesProblem id:p_dpp .

