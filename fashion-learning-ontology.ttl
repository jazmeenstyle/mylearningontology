ex:house
    a fd:Brand ;
    rdfs:label "Example House (fictional)"@en .

ex:style
    a fd:ProductModel ;
    rdfs:label "Example crewneck sweater, style EX-0001 (fictional)"@en ;
    fd:brandOf ex:house ;
    fd:hasVariant ex:item .

ex:item
    a fd:TradeItem ;
    rdfs:label "Example crewneck, colour navy, size M (fictional)"@en ;
    fd:gtin "00000000000000" ;
    fd:hasComposition ex:comp1 ;
    fd:madeFromLot ex:lot .

ex:comp1
    a fd:MaterialComposition ;
    rdfs:label "100% wool (example)"@en ;
    fd:ofMaterial ex:wool ;
    fd:percentage "100"^^xsd:decimal .

ex:wool
    a fd:Material ;
    rdfs:label "Wool (example)"@en .

ex:lot
    a fd:Lot ;
    rdfs:label "Wool yarn lot L-001 (fictional)"@en ;
    fd:lotOfMaterial ex:wool ;
    fd:producedAt ex:facility .

ex:facility
    a fd:Facility ;
    rdfs:label "Example spinning mill (fictional)"@en ;
    fd:osId "XX0000000EXAMPLE" .

ex:certifier
    a fd:Certifier ;
    rdfs:label "Example certification body (fictional)"@en .

ex:cert
    a fd:Certificate ;
    rdfs:label "Example certificate EX-CERT-001 (fictional)"@en ;
    fd:issuedBy ex:certifier ;
    fd:underScheme id:oekostd100 ;
    fd:coversFacility ex:facility ;
    fd:coversMaterial ex:wool ;
    fd:certificateNumber "EX-CERT-001" ;
    fd:validFrom "2026-01-01"^^xsd:date ;
    fd:validTo "2026-12-31"^^xsd:date .

ex:claim
    a fd:Claim ;
    rdfs:label "Claim: this crewneck contains certified wool (example)"@en ;
    fd:aboutItem ex:item ;
    fd:aboutMaterial ex:wool ;
    fd:assertedBy ex:house ;
    fd:supportedBy ex:cert .

ex:check
    a fd:Verification ;
    rdfs:label "Verification of EX-CERT-001 (example)"@en ;
    fd:verifies ex:cert ;
    fd:performedBy ex:house ;
    fd:verificationDate "2026-02-01"^^xsd:date ;
    fd:verificationMethod "Certificate number checked against the issuer's online directory" .

ex:event
    a fd:SupplyChainEvent ;
    rdfs:label "Yarn produced at the mill (example)"@en ;
    fd:concerns ex:lot ;
    fd:atFacility ex:facility ;
    fd:eventTime "2026-01-20T09:00:00Z"^^xsd:dateTime ;
    fd:businessStep "producing" .
