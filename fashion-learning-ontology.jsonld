   "@id": "jl:",
   "@type": "owl:Ontology",
   "rdfs:label": {
    "@value": "Fashion information-architecture learning ontology",
    "@language": "en"
   },
   "rdfs:comment": {
    "@value": "A learning ontology for becoming an ontology subject-matter expert for a fashion house. Layer 1 models the learning domain; layer 2 (fd:) is a seed model for fashion traceability. Placeholder namespaces: replace example.org with your own.",
    "@language": "en"
   },
   "dcterms:created": {
    "@value": "2026-11-14",
    "@type": "xsd:date"
   },
   "owl:versionInfo": "0.1",
