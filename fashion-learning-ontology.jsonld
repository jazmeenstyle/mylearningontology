   "rdfs:label": {
    "@value": "Evidence",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "Material that supports a claim, with a known source, scope, date and method of verification.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide / Career Guide / job description",
   "jl:inDomain": {
    "@id": "jl:TraceabilityProvenanceEvidence"
   },
