   }
  },
  {
   "@id": "id:dpp",
   "@type": "jl:Concept",
   "rdfs:label": {
    "@value": "Digital Product Passport",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "A product-specific digital information mechanism defined through the applicable legal framework.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide / Career Guide / job description",
   "jl:inDomain": {
    "@id": "jl:RegulationAndReporting"
   },
   "jl:priorityTier": {
