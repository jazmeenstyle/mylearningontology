  {
   "@id": "id:dist_prov_lineage_coc",
   "@type": "jl:Distinction",
   "rdfs:label": {
    "@value": "Provenance vs lineage vs chain of custody",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "Provenance is how data was produced. Lineage is how it moved across systems. Chain of custody records who handled it, when and why.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide, 'study by heart' and distinction boxes",
   "jl:inDomain": {
    "@id": "jl:TraceabilityProvenanceEvidence"
   },
   "jl:targetProficiency": {
    "@id": "jl:DeepExpertise"
   },
   "jl:keyQuestion": "History, system trail or people trail?",
   "jl:contrasts": [
    {
     "@id": "id:provenance"
    },
    {
     "@id": "id:lineage"
    },
    {
     "@id": "id:chainofcustody"
    }
   ]
  },
  {
   "@id": "id:dist_product_event",
   "@type": "jl:Distinction",
   "rdfs:label": {
    "@value": "Identifying a product vs recording its journey",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "GTIN identifies the product type. EPCIS records an event in its journey. Do not merge them.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide, 'study by heart' and distinction boxes",
   "jl:inDomain": {
    "@id": "jl:TraceabilityProvenanceEvidence"
   },
   "jl:targetProficiency": {
    "@id": "jl:DeepExpertise"
   },
   "jl:keyQuestion": "Is this a what or a what-happened?",
   "jl:contrasts": [
    {
     "@id": "id:gtin"
    },
    {
     "@id": "id:epcis"
    }
   ]
  },
  {
   "@id": "id:dist_law_standard",
   "@type": "jl:Distinction",
   "rdfs:label": {
    "@value": "Law vs standard vs certificate",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "Standards are voluntary unless (1) a law points to them, (2) a customer contract demands them or (3) they serve as evidence for a green claim.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide, 'study by heart' and distinction boxes",
   "jl:inDomain": {
    "@id": "jl:TraceabilityProvenanceEvidence"
   },
   "jl:targetProficiency": {
    "@id": "jl:DeepExpertise"
   },
   "jl:keyQuestion": "When does a voluntary standard become required?",
   "jl:contrasts": [
    {
     "@id": "id:textilelabelling"
    },
    {
     "@id": "id:iso22095"
    },
    {
     "@id": "id:oekostd100"
    }
   ]
  },
  {
   "@id": "id:dist_origin",
   "@type": "jl:Distinction",
   "rdfs:label": {
    "@value": "Origin vs last processing step vs origin evidence",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "Related but not interchangeable. An origin claim needs supporting evidence.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide, 'study by heart' and distinction boxes",
   "jl:inDomain": {
    "@id": "jl:TraceabilityProvenanceEvidence"
   },
   "jl:targetProficiency": {
    "@id": "jl:DeepExpertise"
   },
   "jl:keyQuestion": "Which origin do you mean?",
   "jl:contrasts": [
    {
     "@id": "id:origin"
    },
    {
     "@id": "id:cbp_import"
    }
   ]
  },
  {
   "@id": "id:dist_size",
   "@type": "jl:Distinction",
   "rdfs:label": {
    "@value": "Size label vs garment vs body measurement",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "A size label, the garment's actual measurements and the body measurements it is designed to fit are three data points.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide, 'study by heart' and distinction boxes",
   "jl:inDomain": {
    "@id": "jl:TraceabilityProvenanceEvidence"
   },
   "jl:targetProficiency": {
    "@id": "jl:DeepExpertise"
   },
   "jl:keyQuestion": "What does the number describe?",
   "jl:contrasts": {
    "@id": "id:isotc133"
   }
  },
  {
   "@id": "id:dist_impact_claim",
   "@type": "jl:Distinction",
   "rdfs:label": {
    "@value": "Measured impact vs sustainability claim",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "A measured environmental impact (LCA) differs from a general sustainability claim, which needs substantiation under rules such as the anti-greenwashing directive.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide, 'study by heart' and distinction boxes",
   "jl:inDomain": {
    "@id": "jl:TraceabilityProvenanceEvidence"
   },
   "jl:targetProficiency": {
    "@id": "jl:DeepExpertise"
   },
   "jl:keyQuestion": "Measured or merely asserted?",
   "jl:contrasts": [
    {
     "@id": "id:lca"
    },
    {
     "@id": "id:substantiation"
    },
    {
     "@id": "id:ecgt"
    }
   ]
  },
  {
   "@id": "id:dist_cert_scope",
   "@type": "jl:Distinction",
   "rdfs:label": {
    "@value": "Certificate vs universal sustainability",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "Do not record Sustainable = Yes. Record the material, the scheme, the certificate and issuer, the covered facility, validity, the evidence linking it to this product, and the date and method of verification.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide, 'study by heart' and distinction boxes",
   "jl:inDomain": {
    "@id": "jl:TraceabilityProvenanceEvidence"
   },
   "jl:targetProficiency": {
    "@id": "jl:DeepExpertise"
   },
   "jl:keyQuestion": "What exactly does this certificate cover?",
   "jl:contrasts": [
    {
     "@id": "id:gots"
    },
    {
     "@id": "id:claim"
    },
    {
     "@id": "id:evidence"
    }
   ],
   "jl:operationalizedAs": {
    "@id": "fd:Certificate"
   }
  },
