     "@id": "id:gtin"
    },
    {
     "@id": "id:gs1dl"
    },
    {
     "@id": "id:epcis"
    }
   ],
   "jl:relatedTo": {
    "@id": "id:espr_textile"
   },
   "jl:operationalizedAs": {
    "@id": "fd:DigitalProductPassport"
   }
  },
  {
   "@id": "id:doublemateriality",
   "@type": "jl:Concept",
   "rdfs:label": {
    "@value": "Double materiality",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "ESRS lens: impacts on people and planet, and financial effects on the company.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide / Career Guide / job description",
   "jl:inDomain": {
    "@id": "jl:RegulationAndReporting"
   }
  },
  {
   "@id": "id:lca",
   "@type": "jl:Concept",
   "rdfs:label": {
    "@value": "Life-cycle assessment",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "Method for measuring a product's environmental impact across its life.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide / Career Guide / job description",
   "jl:inDomain": {
    "@id": "jl:RegulationAndReporting"
   }
  },
  {
   "@id": "id:epr",
   "@type": "jl:Concept",
   "rdfs:label": {
    "@value": "Extended producer responsibility",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "Producer obligations for products after use, such as textile take-back schemes.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide / Career Guide / job description",
   "jl:inDomain": {
    "@id": "jl:RegulationAndReporting"
   }
  },
  {
   "@id": "id:circularity",
   "@type": "jl:Concept",
   "rdfs:label": {
    "@value": "Circularity",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "Product information that supports durability, reuse, repair, refurbishment, remanufacturing and recycling.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide / Career Guide / job description",
   "jl:inDomain": {
    "@id": "jl:RegulationAndReporting"
   }
  },
  {
   "@id": "id:entityres",
   "@type": "jl:Concept",
   "rdfs:label": {
    "@value": "Entity resolution",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "Deciding whether two records describe the same real-world thing, such as one factory under three names.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide / Career Guide / job description",
   "jl:inDomain": {
    "@id": "jl:TraceabilityProvenanceEvidence"
   },
   "jl:prerequisiteFor": {
    "@id": "id:osid"
   },
   "jl:operationalizedAs": {
    "@id": "fd:Facility"
   }
  },
  {
   "@id": "id:origin",
   "@type": "jl:Concept",
   "rdfs:label": {
    "@value": "Country of origin",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "Origin, place of last processing step and evidence for an origin claim are related but not interchangeable.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide / Career Guide / job description",
   "jl:inDomain": {
    "@id": "jl:TraceabilityProvenanceEvidence"
   },
   "jl:operationalizedAs": {
    "@id": "fd:Claim"
   }
  },
  {
   "@id": "id:substantiation",
   "@type": "jl:Concept",
   "rdfs:label": {
    "@value": "Substantiation",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "Evidence a company holds to back an environmental claim.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide / Career Guide / job description",
   "jl:inDomain": {
    "@id": "jl:RegulationAndReporting"
   },
   "jl:operationalizedAs": {
    "@id": "fd:Claim"
   }
  },
  {
   "@id": "id:dist_espr_dpp",
   "@type": "jl:Distinction",
   "rdfs:label": {
    "@value": "ESPR vs DPP",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "ESPR is the legal framework. A DPP is a product-specific digital information mechanism defined through the applicable legal framework.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide, 'study by heart' and distinction boxes",
   "jl:inDomain": {
    "@id": "jl:TraceabilityProvenanceEvidence"
   },
   "jl:targetProficiency": {
    "@id": "jl:DeepExpertise"
   },
   "jl:keyQuestion": "Which one is the law and which one is the mechanism?",
   "jl:contrasts": [
    {
     "@id": "id:espr"
    },
    {
     "@id": "id:dpp"
    }
   ]
  },
  {
   "@id": "id:dist_csrd_esrs",
   "@type": "jl:Distinction",
   "rdfs:label": {
    "@value": "CSRD vs ESRS",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "CSRD is the corporate reporting directive. ESRS are the standards used within its framework, subject to scope.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide, 'study by heart' and distinction boxes",
   "jl:inDomain": {
    "@id": "jl:TraceabilityProvenanceEvidence"
   },
   "jl:targetProficiency": {
    "@id": "jl:DeepExpertise"
   },
   "jl:keyQuestion": "Which is the directive and which are the reporting standards?",
   "jl:contrasts": [
    {
     "@id": "id:csrd"
    },
    {
     "@id": "id:esrs"
    }
   ]
  },
  {
   "@id": "id:dist_jrc_law",
   "@type": "jl:Distinction",
   "rdfs:label": {
    "@value": "JRC research vs law",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "Scientific recommendations can inform legal requirements. A research report is not itself binding.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide, 'study by heart' and distinction boxes",
   "jl:inDomain": {
    "@id": "jl:TraceabilityProvenanceEvidence"
   },
   "jl:targetProficiency": {
    "@id": "jl:DeepExpertise"
   },
   "jl:keyQuestion": "Can a research recommendation bind a company?",
   "jl:contrasts": [
    {
     "@id": "id:jrcstudy"
    },
    {
     "@id": "id:espr_textile"
    }
   ]
  },
  {
   "@id": "id:dist_trace_dd",
   "@type": "jl:Distinction",
   "rdfs:label": {
    "@value": "Traceability vs due diligence",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "Traceability shows where products and materials came from and how they moved. Due diligence is the wider process of identifying, preventing, mitigating and addressing adverse impacts.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide, 'study by heart' and distinction boxes",
   "jl:inDomain": {
    "@id": "jl:TraceabilityProvenanceEvidence"
   },
   "jl:targetProficiency": {
    "@id": "jl:DeepExpertise"
   },
   "jl:keyQuestion": "Where did it come from, versus what harm did we address?",
   "jl:contrasts": [
    {
     "@id": "id:traceability"
    },
    {
     "@id": "id:duediligence"
    }
   ]
  },
  {
   "@id": "id:dist_evidence_claim",
   "@type": "jl:Distinction",
   "rdfs:label": {
    "@value": "Evidence vs assertion",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "A supplier's statement is a claim. Its reliability depends on context, supporting evidence, verification and the applicable requirement.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide, 'study by heart' and distinction boxes",
   "jl:inDomain": {
    "@id": "jl:TraceabilityProvenanceEvidence"
   },
   "jl:targetProficiency": {
    "@id": "jl:DeepExpertise"
   },
   "jl:keyQuestion": "Is this a statement or something that supports one?",
   "jl:contrasts": [
    {
     "@id": "id:evidence"
    },
    {
     "@id": "id:claim"
    }
   ],
   "jl:operationalizedAs": [
    {
     "@id": "fd:Claim"
    },
    {
     "@id": "fd:Evidence"
    }
   ]
  },
  {
   "@id": "id:dist_committees",
   "@type": "jl:Distinction",
   "rdfs:label": {
    "@value": "JTC 24 vs ISO/IEC JTC 5 vs the Commission",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "The Commission sets the legal framework. CEN-CENELEC JTC 24 and ISO/IEC JTC 5 work on technical standards in different standardisation systems.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide, 'study by heart' and distinction boxes",
   "jl:inDomain": {
    "@id": "jl:TraceabilityProvenanceEvidence"
   },
   "jl:targetProficiency": {
    "@id": "jl:DeepExpertise"
   },
   "jl:keyQuestion": "Who writes what?",
   "jl:contrasts": [
    {
     "@id": "id:jtc24"
    },
    {
     "@id": "id:isoiecjtc5"
    },
    {
     "@id": "id:eucom"
    }
   ]
  },
  {
   "@id": "id:dist_cascale_worldly",
   "@type": "jl:Distinction",
   "rdfs:label": {
    "@value": "Cascale vs Worldly",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "Cascale develops industry frameworks and convenes. Worldly provides software and data solutions used to support assessments.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide, 'study by heart' and distinction boxes",
   "jl:inDomain": {
    "@id": "jl:TraceabilityProvenanceEvidence"
   },
   "jl:targetProficiency": {
    "@id": "jl:DeepExpertise"
   },
   "jl:keyQuestion": "Framework owner or data platform?",
   "jl:contrasts": [
    {
     "@id": "id:cascale"
    },
    {
     "@id": "id:worldly"
    }
   ]
  },
  {
   "@id": "id:dist_schema_model",
   "@type": "jl:Distinction",
   "rdfs:label": {
    "@value": "Schema vs data model vs data dictionary",
    "@language": "en"
   },
   "jl:plainEnglish": {
    "@value": "A data model is the blueprint. A schema is the enforceable contract. A data dictionary explains each field. A taxonomy is hierarchical; an ontology adds relationships and rules.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide, 'study by heart' and distinction boxes",
   "jl:inDomain": {
    "@id": "jl:TraceabilityProvenanceEvidence"
   },
   "jl:targetProficiency": {
    "@id": "jl:DeepExpertise"
   },
   "jl:keyQuestion": "Blueprint, contract or reference?",
   "jl:contrasts": [
    {
