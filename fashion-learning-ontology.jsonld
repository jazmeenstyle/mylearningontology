   },
   "jl:plainEnglish": {
    "@value": "The broader process of identifying, preventing, mitigating and addressing adverse impacts.",
    "@language": "en"
   },
   "dcterms:source": "Reference Guide / Career Guide / job description",
   "jl:inDomain": {
    "@id": "jl:RegulationAndReporting"
   }
  },
